{
  "name": "fifa-tournament",
  "private": true,
  "type": "module",
  "description": "Champions-League-style tournament tracker: Swiss league phase, knockouts, live sync.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test test/unit/",
    "test:integration": "node --test test/integration/",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "wrangler": "4.132.0"
  }
}
