{
  "name": "fifa-tournament",
  "main": "server/worker.js",
  "compatibility_date": "2026-05-03",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
  },
  "durable_objects": {
    "bindings": [{ "name": "TOURNAMENT", "class_name": "TournamentRoom" }],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Tournament"] },
    { "tag": "v2", "renamed_classes": [{ "from": "Tournament", "to": "TournamentRoom" }] },
  ],
}
